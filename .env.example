# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ===========================
# SUPABASE CONFIGURATION
# ===========================
# Get these from your Supabase project dashboard (Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================
# PAYSTACK CONFIGURATION
# ===========================
# VITE_PAYSTACK_PUBLIC_KEY: Use public key (safe for frontend)
# Get from: Paystack Dashboard > Settings > API Keys & Webhooks
VITE_PAYSTACK_PUBLIC_KEY=pk_test_1234567890abcdef...

# PAYSTACK_SECRET_KEY: Use secret key (server-side only!)
# NEVER expose this to the frontend. Only use in backend functions.
# Get from: Paystack Dashboard > Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_1234567890abcdef...

# ===========================
# GOOGLE OAUTH (Optional)
# ===========================
# For social login via Google
# Get from: Google Cloud Console > OAuth 2.0 Credentials
VITE_GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com

# ===========================
# CLERK AUTHENTICATION (Optional Alternative)
# ===========================
# Alternative to Supabase Auth
VITE_CLERK_PUBLISHABLE_KEY=pk_test_1234567890abcdef...

# ===========================
# APP CONFIGURATION
# ===========================
# API base URL (for custom backend if applicable)
VITE_API_BASE_URL=http://localhost:3000/api

# Environment name
VITE_ENVIRONMENT=development

# Debug mode
VITE_DEBUG=true

# ===========================
# ANALYTICS & MONITORING (Optional)
# ===========================
# Sentry error tracking
VITE_SENTRY_DSN=https://key@sentry.io/projectid

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================
# NOTES
# ===========================
# 1. Prefix variables with VITE_ to make them accessible in the frontend
# 2. Variables without VITE_ are only accessible in Node.js/backend
# 3. After updating .env.local, restart the development server
# 4. For production, set these variables in your hosting platform
#    (Vercel: Project Settings > Environment Variables)
# 5. Test values with test mode enabled (e.g., Paystack sandbox mode)

# ADMIN PANEL PASSCODE
# Passcode for the admin panel (/admin). Demo-grade client-side lock:
# change it before any public deployment.
VITE_ADMIN_PASSCODE=<your-passcode>

# MONITORING & ANALYTICS (both optional)
# Sentry error tracking - Settings > Client Keys (DSN) at sentry.io
VITE_SENTRY_DSN=<dsn>
# GA4 Measurement ID (G-XXXXXXXXXX) from analytics.google.com
VITE_GA4_ID=<measurement-id>
